datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CLIENT
  BARBER
  ADMIN
  SALON_DIRECTOR
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id             String    @id @default(uuid())
  logtoSub       String    @unique 
  email          String    @unique
  name           String?
  phone          String?
  role           Role      @default(CLIENT)
  avatarUrl      String?
  specialization String?
  createdAt      DateTime  @default(now())

  barberBookings Booking[] @relation("BarberBookings")
  clientBookings Booking[] @relation("ClientBookings")
  services       Service[] @relation("BarberServices")
}

model Service {
  id          String    @id @default(uuid())
  name        String    
  durationMin Int       
  price       Decimal   @db.Decimal(10, 2)
  category    String?
  description String?
  barbers     User[]    @relation("BarberServices")
  bookings    Booking[]
}

model Booking {
  id          String        @id @default(uuid())
  barberId    String
  clientId    String
  serviceId   String
  startTime   DateTime
  endTime     DateTime
  status      BookingStatus @default(CONFIRMED)
  notes       String?
  createdAt   DateTime      @default(now())

  barber  User    @relation("BarberBookings", fields: [barberId], references: [id], onDelete: Cascade)
  client  User    @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([barberId, startTime, endTime])
}